# ===================================================================
# AgentKnowledgeMesh · 容器部署环境变量示例
#
# 用法:
#   cp .env.example .env       # 本文件与 compose 文件放在同一目录(仓库中即 deploy/)
#   然后按需修改。compose 会自动读取同目录的 .env,不需要 export。
#
#   仓库中(compose 在 deploy/):
#     docker compose -f deploy/docker-compose.yml up -d                    # SQLite(无 RAG)
#     docker compose -f deploy/docker-compose.pg.yml up -d                 # 内置 pgvector(含 RAG)
#     docker compose -f deploy/docker-compose.external-pg.yml up -d        # 外接已有 PostgreSQL
#     docker compose -f deploy/docker-compose.node.yml up -d               # 节点容器
#     # 源码构建(叠加文件,镜像改成本机构建):
#     docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.build.yml up -d --build
#
#   Release 分发包中(compose 与本文件同目录,镜像 tag 已固定为版本号):
#     docker compose up -d
#     docker compose -f docker-compose.pg.yml up -d
#     docker compose -f docker-compose.external-pg.yml up -d
#
# 说明:
#   - 本文件只列「容器部署」需要调整的变量;应用自身的完整配置项见
#     src/server/.env.example(server)与 src/node/app/config.py(node)
#   - 每个变量都有默认值(见 `默认:` 注释),整份文件删光也能起
#   - .env 已被 .gitignore 忽略(密钥不入库);本示例文件入库,并随 Release 分发
#   - 一个 .env 服务全部 compose 模式,用不到的段落留空即可
# ===================================================================


# ------------------------------------------------------------------
# 1. 镜像与版本
# ------------------------------------------------------------------

# 镜像模式:GHCR 发布镜像的 tag。Release 分发包会把 latest 替换为具体版本
# 默认: latest
AKM_HUB_VERSION=latest

# 源码构建模式(叠加 docker-compose.build.yml):本机构建的镜像名与 tag
# 默认: akm-hub:local / akm-node:local
AKM_HUB_IMAGE=akm-hub:local
AKM_NODE_IMAGE=akm-node:local

# 源码构建:额外可选依赖。留空 = 与发布镜像一致(ark HTTP 嵌入,不含 torch);
# 需要离线本地嵌入模型时设为 local-embedding(会显著增大镜像体积与构建时长)
# 默认: 留空
AKM_UV_EXTRAS=


# ------------------------------------------------------------------
# 2. 端口与容器名
# ------------------------------------------------------------------

# Hub 对宿主机暴露的端口(容器内固定 8000)
# 默认: 18000
AKM_HUB_PORT=18000

# 容器名。同一台机器跑多套(如测试/生产并存)时改这里避免冲突
# 默认: akm-hub / akm-postgres / akm-node
AKM_HUB_CONTAINER_NAME=akm-hub
AKM_POSTGRES_CONTAINER_NAME=akm-postgres
AKM_NODE_CONTAINER_NAME=akm-node


# ------------------------------------------------------------------
# 3. 知识库目录
# ------------------------------------------------------------------

# 宿主机上的知识库根目录(Markdown 存放位置),只读挂载到容器内 /knowledge。
# 相对路径相对「执行 compose 的目录」解析,建议写绝对路径
# 默认: ./knowledge
KNOWLEDGE_DIR=./knowledge


# ------------------------------------------------------------------
# 4. 子路径部署(整个服务挂在反向代理的某个前缀下)
# ------------------------------------------------------------------

# 部署前缀。留空 = 部署在域名根路径(https://xx.com/)。
# 需要 https://xx.com/akm/ 或 https://xx.com/akm-hub/ 这类地址时填前缀本身。
#
# 支持**任意层级**,前缀叫什么、多少层由客户的网关决定,不需要改镜像、也不需要
# 重新构建前端:同一个前端产物在运行期读取该前缀(服务端注入到 index.html)。
#   AKM_ROOT_PATH=/akm
#   AKM_ROOT_PATH=/akm-hub
#   AKM_ROOT_PATH=/internal/tools/akm
#
# 反代两种写法都支持,选一种即可(以 nginx 为例,前缀 /akm):
#   # 写法 A:保留前缀转发(proxy_pass 不带尾斜杠)
#   location /akm/ {
#       proxy_pass http://127.0.0.1:18000;
#       proxy_set_header Host $host;
#       proxy_set_header X-Forwarded-Proto $scheme;
#       proxy_set_header Upgrade $http_upgrade;      # WebSocket(节点通道)
#       proxy_set_header Connection "upgrade";
#   }
#   # 写法 B:剥离前缀转发(proxy_pass 带尾斜杠)
#   location /akm/ {
#       proxy_pass http://127.0.0.1:18000/;
#       proxy_set_header Host $host;
#       proxy_set_header X-Forwarded-Proto $scheme;
#       proxy_set_header Upgrade $http_upgrade;
#       proxy_set_header Connection "upgrade";
#   }
# Caddy 只需一行(保留前缀,自动处理 WebSocket 升级):
#   xx.com { reverse_proxy /akm/* 127.0.0.1:18000 }
#
# 默认: 留空(根路径部署)
AKM_ROOT_PATH=


# ------------------------------------------------------------------
# 5. 管理员账号
# ------------------------------------------------------------------

# Web 首次启动时创建的管理员账号
# 不设 AKM_ADMIN_PASSWORD 时随机生成,打印在容器日志:
#   docker compose -f deploy/docker-compose.yml logs akm-hub | grep 一次性密码
AKM_ADMIN_USERNAME=admin
AKM_ADMIN_PASSWORD=


# ------------------------------------------------------------------
# 6. 数据库
# ------------------------------------------------------------------

# --- 6.0 通用(两种 PostgreSQL 模式都用;SQLite 模式忽略本段)---

# 库名与账号。内置 PG 模式下同时用于 akm-hub 与 pgvector 容器,改一处即可
# 默认: agentvault / postgres
AKM_DB_NAME=agentvault
AKM_DB_USER=postgres

# --- 6.1 内置 pgvector(docker-compose.pg.yml)---

# 内置数据库的密码(生产环境务必修改)
# 默认: agentvault
POSTGRES_PASSWORD=agentvault

# pgvector 官方镜像 tag(内置 vector 扩展)
# 默认: pg18
AKM_PGVECTOR_TAG=pg18

# --- 6.2 外接已有 PostgreSQL(docker-compose.external-pg.yml)---

# 已有库的连接信息(容器需能访问到)。未设置 AKM_DB_HOST / AKM_DB_PASSWORD
# 时 compose 会直接报错并提示,不会静默连错库。
#
# AKM_DB_HOST=192.168.1.100     # 已有 PostgreSQL 地址
#                               # 若就在同一台 Docker 宿主机上:
#                               #   Windows/Mac 用 host.docker.internal
#                               #   Linux 用宿主机内网 IP
# AKM_DB_PORT=5432
# AKM_DB_PASSWORD=your-password


# ------------------------------------------------------------------
# 7. 向量嵌入(语义检索 / RAG;仅 PG 模式可用)
# ------------------------------------------------------------------

# ark   = 火山引擎 doubao-embedding(默认,中文效果好,需 API Key)
# local = 本地 sentence-transformers(免费离线,需源码构建加装依赖:
#         AKM_UV_EXTRAS=local-embedding)
# 默认: ark / doubao-embedding-vision-250615
AKM_EMBEDDING_PROVIDER=ark
AKM_EMBEDDING_MODEL=doubao-embedding-vision-250615

# 获取 Key: https://console.volcengine.com/ark
# 不填则语义检索报「AKM_ARK_API_KEY 未配置」,关键词检索不受影响
AKM_ARK_API_KEY=
AKM_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3


# ------------------------------------------------------------------
# 8. 节点容器(docker-compose.node.yml)
# ------------------------------------------------------------------

# 节点在 Web「节点」页显示的名字
# 默认: akm-docker-node
AKM_NODE_NAME=akm-docker-node

# Hub 管理员账号(可选):配齐后节点容器**首次启动自动登录**换取凭证并写入
# akm-node-state 卷,无需先跑 `run --rm ... login` 那一步(无人值守场景推荐)。
# 已有凭证时直接使用,不会重复登录;凭证失效(Web 端重置/禁用)仍需人工登录。
# ⚠️ 明文密码:凭证落盘后即可把这两行清空。
# AKM_HUB_USERNAME=admin
# AKM_HUB_PASSWORD=

# 容器视角的 Hub 地址。host.docker.internal 指向宿主机。
#
# ⚠️ 端口要对上 Hub 实际的宿主机端口:
#   - Hub 用 deploy compose 起 → 是 AKM_HUB_PORT(默认 18000)
#   - Hub 在宿主机直接跑(uv run akm-hub) → 8000
#   若节点容器与 Hub 在同一个 compose 网络内,可直接写服务名(如 http://akm-hub:8000/api)
#
# ⚠️ Hub 若部署在子路径下(见上面第 4 节),这两个地址都要带上前缀:
#   AKM_HUB_API_URL=https://xx.com/akm/api
#   AKM_HUB_URL=wss://xx.com/akm/ws
#   (用 `akm-node login` 交互登录时只填带前缀的 API 地址,WS 地址会自动推导)
#
# ⚠️ 环境变量优先级高于登录写入的凭证文件:换 Hub 地址请改这里后
#   `up -d` 重建容器,容器内执行 login 不会覆盖该地址。
AKM_HUB_API_URL=http://host.docker.internal:8000/api
AKM_HUB_URL=ws://host.docker.internal:8000/ws


# ------------------------------------------------------------------
# 9. 节点文件监听与定时对账(add-node-file-watch)
# ------------------------------------------------------------------
# 节点监听知识库目录下的 .md,文件改动数秒内同步到 Hub;另按间隔做全量对账
# 兜底(监听可能丢事件,如跨平台差异 / 网络文件系统)。
# 宿主机安装的节点默认全部开启,一般无需配置。

# 文件监听总开关。
# ⚠️ 节点跑在容器里(第 8 节)时默认关闭:Windows / macOS 宿主的 bind mount
#    不传播 inotify 事件,监听会**静默失效** —— 此时依赖定时对账。
#    Linux 宿主可设为 true(内核原生支持事件传播)。
# 默认: true(宿主机) / false(节点容器,compose 已置)
# AKM_WATCH_ENABLED=true

# 事件防抖窗口(秒)。编辑器保存 / git checkout / 批量复制会产生密集事件,
# 聚合后再触发一次同步。调小可降低延迟,但批量操作时上传轮次会变多。
# 默认: 3
# AKM_WATCH_DEBOUNCE_SECONDS=3

# 定时全量对账间隔(秒);0 = 关闭对账,仅依赖监听(接受丢事件风险)。
# 知识库很大时可调大该值。
# 默认: 300
# AKM_WATCH_RECONCILE_SECONDS=300

# 在内置排除目录(node_modules / dist / build / __pycache__)之外追加的
# 排除目录名,逗号分隔。以 "." 开头的隐藏目录始终排除。
# 默认: 空
# AKM_WATCH_EXCLUDE=
