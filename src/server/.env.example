# ===================================================================
# AgentKnowledgeMesh 环境变量示例
#
# 使用方法:
#   cp .env.example .env   然后按需修改
#
# 说明:
#   - 所有配置项都有默认值，零配置即可启动（SQLite + 本地嵌入模型）
#   - 未列出的高级配置项见 app/config.py
#   - .env 已被 .gitignore 忽略，密钥不会被提交
# ===================================================================


# ------------------------------------------------------------------
# 1. 服务配置
# ------------------------------------------------------------------
AV_HOST=0.0.0.0
AV_PORT=8000
AV_DEBUG=false


# ------------------------------------------------------------------
# 2. 知识库目录（Markdown 文件存放位置）
#    - 多个目录用英文逗号分隔
#    - 不配置则默认使用 ~/Knowledge
# ------------------------------------------------------------------
# AV_KNOWLEDGE_ROOTS=/Users/me/Knowledge
# AV_KNOWLEDGE_ROOTS=/Users/me/docs,/Users/me/notes


# ------------------------------------------------------------------
# 3. 主数据库（文档表 / 节点表）
#    - sqlite:  零配置，单机使用（默认）
#    - postgres: 生产环境推荐，需安装 PostgreSQL
# ------------------------------------------------------------------
AV_DB_TYPE=sqlite

# --- SQLite 模式（AV_DB_TYPE=sqlite 时生效）---
# AV_DB_PATH=data/agentvault.db

# --- PostgreSQL 模式（AV_DB_TYPE=postgres 时生效）---
# AV_DB_HOST=localhost
# AV_DB_PORT=5432
# AV_DB_NAME=agentvault
# AV_DB_USER=postgres
# AV_DB_PASSWORD=your-password


# ------------------------------------------------------------------
# 4. 向量数据库（语义搜索 / RAG，基于 PostgreSQL + pgvector 扩展）
#
#    规则:
#    - 主库是 postgres: 整段留空，向量表自动和文档表存同一个库
#    - 主库是 sqlite:   取消注释，单独填一个装了 pgvector 的 PostgreSQL
#
#    pgvector 安装: https://github.com/pgvector/pgvector
# ------------------------------------------------------------------
# AV_VECTOR_DB_HOST=localhost
# AV_VECTOR_DB_PORT=5432
# AV_VECTOR_DB_NAME=agentvault
# AV_VECTOR_DB_USER=postgres
# AV_VECTOR_DB_PASSWORD=your-password

# 向量表名（一般不用改）
# AV_VECTOR_DB_TABLE=document_vectors

# 向量维度，0 = 首次嵌入时自动检测（一般不用改）
# AV_VECTOR_DB_DIMENSIONS=0


# ------------------------------------------------------------------
# 5. 向量嵌入模型（语义搜索的文本向量化）
#
#    - local: 本地 sentence-transformers 模型，免费离线（默认）
#    - ark:   火山引擎 doubao-embedding 系列，中文效果好，需 API Key
# ------------------------------------------------------------------
AV_EMBEDDING_PROVIDER=local
AV_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- 火山引擎模式（AV_EMBEDDING_PROVIDER=ark 时生效）---
# 获取 Key: https://console.volcengine.com/ark
# AV_EMBEDDING_PROVIDER=ark
# AV_EMBEDDING_MODEL=doubao-embedding-vision-250615
# AV_ARK_API_KEY=your-ark-api-key
# AV_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3


# ------------------------------------------------------------------
# 6. 文档分块（长文档切分成小块再向量化，一般不用改）
# ------------------------------------------------------------------
# AV_CHUNK_SIZE=500        # 每块目标字符数
# AV_CHUNK_OVERLAP=50      # 相邻块重叠字符数

# ------------------------------------------------------------------
# 7. 扫描配置（一般不用改）
# ------------------------------------------------------------------
# AV_SCAN_EXTENSIONS=.md   # 扫描的文件扩展名（逗号分隔）
# AV_MAX_FILE_SIZE_MB=10   # 跳过超过此大小的文件
