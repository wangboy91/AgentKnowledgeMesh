# ===================================================================
# AgentKnowledgeMesh Node 端环境变量示例
#
# Node 是跑在各台机器上的轻量客户端：扫描本地 Markdown，
# 通过 WebSocket 同步到 Hub（server）。
#
# 使用方法:
#   cp .env.example .env   然后按需修改
#   uv run akm-node
# ===================================================================


# ------------------------------------------------------------------
# 1. Hub 连接地址（必填，指向 server 端）
# ------------------------------------------------------------------
AKM_HUB_URL=ws://hub-ip:8000/ws
AKM_HUB_API_URL=http://hub-ip:8000/api


# ------------------------------------------------------------------
# 2. 本机知识库目录（必填，要同步的 Markdown 所在位置）
#    多个目录用英文逗号分隔
# ------------------------------------------------------------------
AKM_KNOWLEDGE_ROOTS=/Users/me/Knowledge
# AKM_KNOWLEDGE_ROOTS=/Users/me/docs,/Users/me/notes


# ------------------------------------------------------------------
# 3. 节点信息（可选，默认自动用机器名）
# ------------------------------------------------------------------
# AKM_NODE_NAME=my-macbook


# ------------------------------------------------------------------
# 4. Hub 账号（可选，用于免交互启动）
#
#    配置后：启动时若本地还没有节点凭证（AKM_NODE_TOKEN），会自动用这组
#    账号登录 Hub 换取凭证并写入 ~/.akm-node/.env，无需人工执行 login。
#    已有凭证时以凭证为准，不会重复登录。
#    适合 systemd / 计划任务 / 容器等无人值守场景。
#
#    ⚠️ 密码在此是明文；首次自动登录后凭证已落盘，即可把这两行删掉/移出配置。
#       也可用 `akm-node login` 交互登录（等价，凭证落同一处）。
# ------------------------------------------------------------------
# AKM_HUB_USERNAME=admin
# AKM_HUB_PASSWORD=changeme


# ------------------------------------------------------------------
# 5. 上传分批（大知识库首次接入时按需调整）
#
#    节点把一轮同步的文档切分为多个请求发送。默认单请求不超过
#    512 KiB / 50 条，单个请求体足够小，即便 Hub 挂在 nginx 后面
#    （默认 client_max_body_size 1m，超出返回 413 Request Entity
#    Too Large）也能正常同步任意规模的知识库。
#
#    一般不用改。若 Hub 是内网直连、没有反向代理，调大可减少请求数：
#      AKM_UPLOAD_BATCH_BYTES=2097152      # 单请求体上限（字节）
#      AKM_UPLOAD_BATCH_DOCS=200           # 单请求文档条数上限
#
#    置 0 或负数表示该维度不限制（两个都如此即等于不分批，退回旧行为）。
#    注意：调大需确认对端 nginx 的 client_max_body_size 也同步放大，
#    否则会 413。
# ------------------------------------------------------------------
# AKM_UPLOAD_BATCH_BYTES=524288
# AKM_UPLOAD_BATCH_DOCS=50


# ------------------------------------------------------------------
# 6. 多环境隔离（同一台机器上正式 / 开发并行）
#
#    想在开发仓里跑调试实例、同时让正式节点长期在线时，用下面两个变量
#    把「凭证」与「快照」分别落到不同目录。
#
#    ⚠️ 这两个变量必须由「启动脚本」在进程环境里设置，写在本文件里不生效：
#       app/config.py 在模块 import 时用 os.environ 读取它们，早于本文件
#       的加载（pydantic-settings 的 env_file），且不报错——只会表现为
#       "文档莫名没同步"。仓库已提供启动脚本把这件事固化：
#         deploy/start-node-prod.ps1（Windows）/ deploy/start-node-prod.sh
#
#    正式实例还应显式指定一个与开发实例不同的 AKM_NODE_ID：两边共用同一
#    node_id 时，任一实例登录都会轮换 token、把另一实例以 401 顶掉。
#
#    详见 docs/deployment.md §2.6。
# ------------------------------------------------------------------
# AKM_NODE_ENV_FILE=~/.akm-node-prod/.env   # 凭证文件路径（默认 ~/.akm-node/.env）
# AKM_NODE_STATE_DIR=~/.akm-node-prod       # 快照等运行数据目录（默认 ~/.akm-node）


# ------------------------------------------------------------------
# 7. 高级配置（一般不用改）
# ------------------------------------------------------------------
# AKM_HEARTBEAT_INTERVAL=30   # 心跳间隔（秒）
# AKM_NODE_ID=                # 固定节点 ID（默认按机器名自动生成）

# 严格 owner 只读切片（默认关闭；必须显式设置 AKM_KNOWLEDGE_ROOTS）
# AKM_OWNER_READONLY_ENABLED=false
# AKM_OWNER_SCAN_SECONDS=3
# 此模式只上报元数据，按需内存回复正文；禁用旧全文同步和第三方正文 MCP，写回未支持。
# owner 身份/墓碑状态落 AKM_NODE_STATE_DIR/owner-readonly/，保留此元数据以避免身份重建。
