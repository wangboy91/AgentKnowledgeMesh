# AgentVault Configuration

# Server
AV_HOST=0.0.0.0
AV_PORT=8000
AV_DEBUG=false

# Database type: sqlite / postgres
AV_DB_TYPE=sqlite

# SQLite configuration
AV_DB_PATH=data/agentvault.db

# PostgreSQL configuration (only when AV_DB_TYPE=postgres)
# AV_DB_HOST=localhost
# AV_DB_PORT=5432
# AV_DB_NAME=agentvault
# AV_DB_USER=postgres
# AV_DB_PASSWORD=your_password

# Knowledge directories (comma-separated for multiple)
# Examples:
#   Single:   AV_KNOWLEDGE_ROOTS=/Users/me/obsidian-doc
#   Multiple: AV_KNOWLEDGE_ROOTS=/Users/me/obsidian-doc,/Users/me/projects/docs,/home/server/knowledge
AV_KNOWLEDGE_ROOTS=/Users/me/obsidian-doc
